post_install() {
  cat <<'EOF'
Commander installed.

Suggested next steps:
  1. Copy /usr/share/commander/hyprland/commander.conf into your Hyprland config
  2. Enable the user services if desired:
     systemctl --user enable --now system-agent.service
     systemctl --user enable --now system-agent-trainer.service
  3. Review ~/.config/system-agent-harness/config.json
EOF
}

post_upgrade() {
  post_install
}
