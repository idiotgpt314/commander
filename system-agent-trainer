#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"
PYTHON_BIN="$SCRIPT_DIR/.venv/bin/python"
APP_DIR="$SCRIPT_DIR"

if [[ ! -x "$PYTHON_BIN" && -f /usr/lib/commander/system_agent_trainer.py ]]; then
  PYTHON_BIN="/usr/bin/python"
  APP_DIR="/usr/lib/commander"
  cd "$APP_DIR"
fi

exec "$PYTHON_BIN" "$APP_DIR/system_agent_trainer.py" "$@"
