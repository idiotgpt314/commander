#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

PYTHON_BIN="$SCRIPT_DIR/.venv/bin/python"
APP_DIR="$SCRIPT_DIR"

if [[ ! -x "$PYTHON_BIN" && -f /usr/lib/commander/system_agent.py ]]; then
  PYTHON_BIN="/usr/bin/python"
  APP_DIR="/usr/lib/commander"
  cd "$APP_DIR"
fi

for arg in "$@"; do
  if [[ "$arg" == "--print-config" || "$arg" == "--init-config" ]]; then
    exec "$PYTHON_BIN" "$APP_DIR/system_agent.py" "$@"
  fi
done

if command -v ldconfig >/dev/null 2>&1; then
  ldconfig_output="$(ldconfig -p 2>/dev/null || true)"
  layer_shell_lib="$(printf '%s\n' "$ldconfig_output" | sed -n '/libgtk4-layer-shell\.so/{s/.* => //;p;q;}')"
  if [[ -n "${layer_shell_lib:-}" ]]; then
    export LD_PRELOAD="${layer_shell_lib}${LD_PRELOAD:+:${LD_PRELOAD}}"
  fi
fi

exec "$PYTHON_BIN" "$APP_DIR/system_agent.py" "$@"
